* text=auto

# run on macOS/Linux: must stay LF even when checked out on Windows
*.sh          text eol=lf
*.fish        text eol=lf
macos/zshrc   text eol=lf
macos/Brewfile text eol=lf
linux/**      text eol=lf
.config/**    text eol=lf
.ssh/**       text eol=lf

*.ps1         text eol=crlf

# Windows Terminal rewrites its settings with LF; keep the repo copy the same
# so the installer doesn't see a difference (and back it up) on every run
windows/windows-terminal/** text eol=lf

*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.ttf  binary
