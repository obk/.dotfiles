[user]
    name = obk
    email = 68072031+obk@users.noreply.github.com
    signingKey = ~/.ssh/obk.pub

[core]
    compression = 9
    preloadindex = true

[apply]
    # refuse patches that add trailing whitespace or mixed indentation
    whitespace = error

[init]
    defaultBranch = main

[url "git@github.com:"]
    insteadOf = "gh:"

[url "git@github.com:obk/"]
    insteadOf = "obk:"

[gpg]
    format = ssh

[commit]
    gpgSign = true

[tag]
    gpgSign = true

[gpg "ssh"]
    # lists which key belongs to which email, so git can verify signatures;
    # the installers add signingKey above to it
    allowedSignersFile = ~/.ssh/allowed_signers
